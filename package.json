{
  "name": "dsh-session-status-colors",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Colour the sidebar Session titles by state: green while a session is open or working, amber while it waits on you, grey once archived.",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0 <0.4.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
